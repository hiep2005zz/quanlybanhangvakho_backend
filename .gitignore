# ==========================================
# Frontend (Node / React / Vite)
# ==========================================
**/node_modules/
**/.pnp
**/.pnp.js

# Production build
**/dist/
**/dist-ssr/
**/build/
*.local

# TypeScript build cache
*.tsbuildinfo

# ==========================================
# Backend (Python / FastAPI)
# ==========================================
**/venv/
**/.venv/
**/env/
**/ENV/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Logs
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Environment variables (Bảo mật thông tin API / DB)
# ==========================================
**/.env
**/.env*.local

# ==========================================
# IDE & OS files
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db# ==========================================
